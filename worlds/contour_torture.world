<?xml version="1.0" ?>
<!--
  Contour-following torture course.

  A 5 x 5 m room ringed with the shapes that break a reactive follower, each one
  isolated so a failure names itself instead of being "it got stuck somewhere".
  Drive it with oomwoo_clean's contour_follow and watch ~/state and the fitted
  curve in ~/debug_markers.

  Going clockwise from the north-west, at a 0.20 m standoff:

    pillar_square    a convex corner with no rounding at all
    fin_north        a 3 cm thin wall: a sharp TIP to wrap 180 deg around
    pillar_round     a 10 cm round pillar, the easy curved case
    table_legs       four 4 cm legs, the case that ends runs, because the
                     follower can orbit one forever and the next one is not in
                     the follow-side sector until it is too close
    diagonal         a 45 deg wall: neither axis-aligned nor curved
    corridor         a fin 0.5 m off the south wall: walls on both sides
    alcove           a concave U: three inside corners in a row
    low_lip          6 cm tall, and the scan plane is at 8.8 cm, so the LiDAR
                     CANNOT see it. Only the bumper can. Expected to fail until
                     the bumper handoff exists, and it keeps that honest

  Every gap between obstacles is at least 0.45 m, against a 0.349 m robot, so
  nothing here is a slot the robot cannot physically fit through: a crash
  should mean the follower failed, not that the course was unwinnable. (The
  low lip is the one deliberate exception.) An earlier version broke this rule
  with a panel 0.275 m off the wall, and the robot duly drove into it.

  Grid squares are 1 m, so RViz gives a free ruler.
-->
<sdf version="1.10">
  <world name="default">
    <scene>
      <shadows>false</shadows>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>
    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>0 0 12 0 1.5138 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>1e-05</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <!-- Required for contact/bumper sensors to publish. A robot's model-level
         Contact plugin is a no-op; without this world-level system the contact
         topics exist but stay permanently silent. -->
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <include>
      <uri>model://ground plane</uri>
      <name>ground_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <intensity>3</intensity>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 5 x 5 m room -->
    <model name="wall_west">
      <static>true</static>
      <include><uri>model://room_wall_2x5m</uri></include>
      <pose>-2.5 0 1 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <model name="wall_east">
      <static>true</static>
      <include><uri>model://room_wall_2x5m</uri></include>
      <pose>2.5 0 1 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <model name="wall_north">
      <static>true</static>
      <include><uri>model://room_wall_2x5m</uri></include>
      <pose>0 2.45 1 0 0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>
    <model name="wall_south">
      <static>true</static>
      <include><uri>model://room_wall_2x5m</uri></include>
      <pose>0 -2.45 1 0 0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- NW: square pillar. A convex corner with no rounding at all. -->
    <model name="pillar_square">
      <static>true</static>
      <pose>-1.5 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
          <material><diffuse>0.55 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- N: a 3 cm fin off the north wall. Its free end is the sharpest convex
         turn in the course: a 180 deg wrap around a tip. -->
    <model name="fin_north">
      <static>true</static>
      <pose>0 1.9 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 1.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 1.1 0.5</size></box></geometry>
          <material><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- NE: round pillar, the well-conditioned curved case. -->
    <model name="pillar_round">
      <static>true</static>
      <pose>1.5 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.1</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>0.5</length></cylinder></geometry>
          <material><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- E: a coffee table's four 4 cm legs. The top sits above the scan plane,
         so the LiDAR sees four small circles in a square. Orbit one and you
         never leave; miss one and you hit it. -->
    <model name="table_legs">
      <static>true</static>
      <pose>1.6 -0.2 0 0 0 0</pose>
      <link name="link">
        <collision name="leg_a_col">
          <pose>-0.25 -0.25 0.2 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="leg_a">
          <pose>-0.25 -0.25 0.2 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
          <material><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <collision name="leg_b_col">
          <pose>0.25 -0.25 0.2 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="leg_b">
          <pose>0.25 -0.25 0.2 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
          <material><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <collision name="leg_c_col">
          <pose>0.25 0.25 0.2 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="leg_c">
          <pose>0.25 0.25 0.2 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
          <material><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <collision name="leg_d_col">
          <pose>-0.25 0.25 0.2 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="leg_d">
          <pose>-0.25 0.25 0.2 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
          <material><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <collision name="top_col">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>0.7 0.7 0.04</size></box></geometry>
        </collision>
        <visual name="top">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>0.7 0.7 0.04</size></box></geometry>
          <material><diffuse>0.45 0.3 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SE: a 45 deg wall. Neither axis-aligned nor curved. -->
    <model name="diagonal">
      <static>true</static>
      <pose>1.5 -1.5 0.25 0 0 0.7854</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 1.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 1.0 0.5</size></box></geometry>
          <material><diffuse>0.6 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- S: a 0.5 m corridor, formed by one fin and the south wall itself (inner
         face y = -2.40), so the robot has walls on both sides at once and the
         nearest surface can swap sides mid-run. -->
    <model name="corridor">
      <static>true</static>
      <pose>-0.1 -1.875 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.05 0.5</size></box></geometry>
          <material><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SW: a concave alcove, three inside corners in a row. -->
    <model name="alcove_back">
      <static>true</static>
      <pose>-1.9 -1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 0.9 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.9 0.5</size></box></geometry>
          <material><diffuse>0.5 0.6 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="alcove_north">
      <static>true</static>
      <pose>-1.6 -1.075 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.65 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.05 0.5</size></box></geometry>
          <material><diffuse>0.5 0.6 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="alcove_south">
      <static>true</static>
      <pose>-1.6 -1.925 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.65 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.05 0.5</size></box></geometry>
          <material><diffuse>0.5 0.6 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- W: a 6 cm lip along the wall. The scan plane is at 8.8 cm
         (floor_clearance 0.0125 + lower_cylinder_height 0.0665 + laser_puck
         0.009), so the LiDAR passes straight over this and the robot drives
         into it. Only the bumper can catch it. Expected to fail until the
         bumper handoff lands ; the course should keep that visible, not hide
         it. -->
    <model name="low_lip">
      <static>true</static>
      <pose>-2.25 0.3 0.03 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 1.2 0.06</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.2 0.06</size></box></geometry>
          <material><diffuse>0.8 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
