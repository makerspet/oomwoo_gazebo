<?xml version="1.0" ?>
<!--
  Contour-following torture course, generated by script/make_contour_torture.py.
  Edit the layout there and re-run it; hand edits here will be overwritten.

  A 12 x 6 m room. The follower keeps the wall on its right and the robot spawns
  facing +x, so it runs the course anticlockwise:

    south wall ("right")    comb A: square teeth, gaps 2.0d, 1.1d, 0.9d
    east wall ("distant")   comb B: blocks, a leg, legs in a row, thick legs
    north wall ("left")     comb C: wedge, blocks off the wall, convex and concave
                            arcs (one too tight to enter), and a V trap
    west wall               plain, back to the start

  Start it on the south wall:
    ros2 launch oomwoo_gazebo world.launch.py world:=contour_torture.world
        x_pose:=-5.4 y_pose:=-2.77 odom_source:=robot_wheels

  Some gaps are deliberately too narrow (d = robot diameter, 0.349 m):
    wall_east            B3_leg               0.250 m  (does not fit)
    wall_east            B4_legs_pair         0.250 m  (does not fit)
    wall_east            B5_thick_legs_pair   0.250 m  (does not fit)
    wall_north           C2_block_gap_025     0.250 m  (does not fit)
    A3_tooth             A4_tooth             0.314 m  (does not fit)
    A2_tooth             A3_tooth             0.384 m

  Features:
    A1_tooth             gap after it: 2.0d = 0.698 m
    A2_tooth             gap after it: 1.1d = 0.384 m
    A3_tooth             gap after it: 0.9d = 0.314 m
    B1_block_small       0.3 deep x 0.2 wide
    B2_block_wide        0.3 deep x 0.6 wide
    B3_leg               4 cm leg, 0.25 m off the wall
    B4_legs_pair         two 4 cm legs in a row out from the wall, 0.46 m apart (passable)
    B5_thick_legs_pair   two 10 cm legs in a row, 0.40 m apart (tight)
    C1_wedge             90 deg wedge jutting 0.35 m (a square half buried in the wall)
    C2_block_gap_025     free-standing, 0.25 m off the wall: too narrow to pass behind
    C3_block_gap_050     free-standing, 0.50 m off the wall: passable behind
    C4_convex_R035       convex half-cylinder, R = 0.35 (two robot radii)
    C5_concave_R035      concave bay, R = 0.35: the robot fits, with ~5 cm to spare
    C6_convex_R015       convex half-cylinder, R = 0.15: a tight outside curve
    C7_concave_R017      concave bay, R = 0.17: 0.34 m wide, the robot does NOT fit
    C8_v_trap            V pocket 0.8 m wide x 0.8 m deep (53 deg): in you go, and it narrows
-->
<sdf version="1.10">
  <world name="default">
    <scene>
      <shadows>false</shadows>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>
    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>-9 0 9 0 0.75 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>1e-05</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <!-- Required for contact/bumper sensors to publish. A robot's model-level
         Contact plugin is a no-op; without this world-level system the contact
         topics exist but stay permanently silent. -->
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <include>
      <uri>model://ground plane</uri>
      <name>ground_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <intensity>3</intensity>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="col_0">
          <pose>0.0000 -3.2000 0.250 0 0 0.00000</pose>
          <geometry><box><size>12.8000 0.4000 0.500</size></box></geometry>
        </collision>
        <visual name="vis_0">
          <pose>0.0000 -3.2000 0.250 0 0 0.00000</pose>
          <geometry><box><size>12.8000 0.4000 0.500</size></box></geometry>
          <material><diffuse>0.75 0.75 0.78 1</diffuse><ambient>0.75 0.75 0.78 1</ambient></material>
        </visual>
      </link>
