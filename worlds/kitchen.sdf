<?xml version="1.0" ?>
<!--
  Contributed by Alvaro Samudio, from
  https://github.com/alvarosamudio/oomwoo_gazebo (Apache-2.0).

  Vendored into oomwoo_gazebo. The world-level plugin and physics blocks were
  adapted for Gazebo Harmonic / ROS 2 Jazzy. A later manual dimensional pass
  raised the kitchen walls to a realistic residential height and replaced the
  placeholder box chairs with the package's existing Chair asset. See
  docs/kitchen-scale-audit.md.
-->
<sdf version="1.8">
  <world name="kitchen">
    <gravity>0 0 -9.81</gravity>

    <physics name="1ms" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.3999999999999999</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>1.0000000000000001e-05</cfm>
          <erp>0.20000000000000001</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <!-- Renders lidar and camera sensors. Replaces the gz-sim-cpu-lidar-system
         used by the contributed original: Gazebo Harmonic does not ship that
         system, and without this one /scan stays silent. -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <!-- Required for contact/bumper sensors to publish. A robot's model-level
         Contact plugin is a no-op; without this world-level system the contact
         topics exist but stay permanently silent. -->
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <scene>
      <ambient>0.4 0.4 0.4</ambient>
      <background>0.7 0.7 0.7</background>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2.4 m residential wall height; center is half-height at z=1.2 m. -->
    <model name="wall_back">
      <static>true</static>
      <pose>3.0 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6.0 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.0 2.4</size></box></geometry>
          <material><ambient>0.8 0.8 0.8</ambient><diffuse>0.8 0.8 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_front">
      <static>true</static>
      <pose>-3.0 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6.0 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.0 2.4</size></box></geometry>
          <material><ambient>0.8 0.8 0.8</ambient><diffuse>0.8 0.8 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_left">
      <static>true</static>
      <pose>0 3.0 1.2 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6.0 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.0 2.4</size></box></geometry>
          <material><ambient>0.8 0.8 0.8</ambient><diffuse>0.8 0.8 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_right">
      <static>true</static>
      <pose>0 -3.0 1.2 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6.0 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6.0 2.4</size></box></geometry>
          <material><ambient>0.8 0.8 0.8</ambient><diffuse>0.8 0.8 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="kitchen_island">
      <static>true</static>
      <pose>0 0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.7 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.7 0.9</size></box></geometry>
          <material><ambient>0.6 0.6 0.6</ambient><diffuse>0.6 0.6 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>-1.5 -1.5 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 0.7</size></box></geometry>
          <material><ambient>0.5 0.3 0.1</ambient><diffuse>0.5 0.3 0.1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Use the same real chair asset already exercised by living_room.world. -->
    <model name="chair_1">
      <static>true</static>
      <pose>-1.5 -0.6 0 0 0 3.14159</pose>
      <include>
        <uri>model://Chair</uri>
      </include>
      <self_collide>false</self_collide>
    </model>

    <model name="chair_2">
      <static>true</static>
      <pose>1.2 1.8 0 0 0 0.3</pose>
      <include>
        <uri>model://Chair</uri>
      </include>
      <self_collide>false</self_collide>
    </model>
  </world>
</sdf>
