<sdf version='1.10'>
  <world name='default'>
    <!--
      Kitchen + dining room, built around the "Kitchen and Dining" model by
      Nate Koenig (Gazebo Fuel, OpenRobotics, CC0 / public domain), vendored
      locally as models/kitchen_dining so nothing is fetched at run time.

      STATUS: VISUAL PREVIEW ONLY - THE ROOM HAS NO COLLISION GEOMETRY.
      The upstream model ships a <visual> and no <collision>, so the robot
      drives straight through every wall, cabinet and chair. It rests on the
      invisible ground plane below and nothing else stops it. This world is
      here to be looked at and critiqued; collision proxies come next.

      Measured extents of the vendored mesh (transforms applied, unit = inch,
      Z_UP, so it is placed at pose 0 0 0):
        x  -3.889 ..  3.825   ( 7.714 m)
        y  -7.415 ..  7.415   (14.830 m)
        z  -0.298 ..  3.342   ( 3.640 m)
      Floor slab sits at z = -0.002, i.e. effectively z = 0. No ceiling slab,
      so the top-down GUI camera below sees the whole layout.
    -->
    <scene>
      <shadows>false</shadows>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
    </scene>
    <gui fullscreen='false'>
      <!-- Near top-down over the room centre, yaw 0 so the long (14.8 m) y
           axis runs across the wider screen axis. Orbit to inspect in 3D. -->
      <camera name='user_camera'>
        <pose>0 -0.13 14 0 1.5138 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <physics type='ode'>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.3999999999999999</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>1.0000000000000001e-05</cfm>
          <erp>0.20000000000000001</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <!-- Required for contact/bumper sensors to publish. A robot's model-level
         Contact plugin is a no-op; without this world-level system the contact
         topics exist but stay permanently silent. -->
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <!-- Collision-only ground plane. NOT model://ground plane: that model's
         grey visual sits at z=0 and would paint over the room's own floor,
         which is the nicest-looking part of the mesh. Collision alone keeps
         the robot standing at exactly floor level with the floor visible. -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <light name='sun' type='directional'>
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <intensity>4</intensity>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <model name='kitchen_dining'>
      <static>true</static>
      <include>
        <uri>model://kitchen_dining</uri>
      </include>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

  </world>
</sdf>
