<sdf version='1.10'>
  <world name='default'>
    <!--
      Kitchen + dining room for the OOMWOO robot vacuum.

      Composed from individually vendored models (models/), not one monolithic
      mesh, so every piece can be moved, swapped or reused by the bedroom /
      office / bathroom worlds later. Nothing is fetched at run time.

      ROOM
        Interior  x [-2.45, 2.45]  = 4.90 m
                  y [-1.90, 1.90]  = 3.80 m   -> 18.6 m^2
        Ceiling   2.50 m (room_wall_25x*m).

      LAYOUT - an L, along the north and east walls
        North wall, west to east:
          fridge (0.90) | base run W (1.144) | RANGE (0.813) | base run E (1.381)
        The range is CENTRED on the north wall at x = 0, so the counter splits
        either side of it. That keeps it reachable: with the counter now also
        running down the east wall, an east-end range would have been boxed in
        by the corner.
        East wall, north to south:
          base run with the DOUBLE SINK + dishwasher (3.15) | pantry (0.60)
        The two runs meet in the NE corner: the north run ends at x = 1.787,
        which is exactly the east run's outermost face (its door handles).

      KITCHEN DIMENSIONS (authored family, all units share them)
        Counter height  0.900     Counter depth   0.635
        Carcass depth   0.600     Slab thickness  0.040
        TOE KICK        0.089 high x 0.076 deep  (3.5" x 3", US standard)
        Wall cabinets   bottom 1.500, top 2.450 (north wall, and east
                        wall either side of the window)
        Dishwasher      0.596 wide, in a gap in the east run beside the sink
        Range           scaled 0.8452 -> top 0.9001, level with the counter
      The toe kick is 0.089 and the robot is 0.097 tall, so it cannot drive
      in. Deliberate, and matches reality - it is the case the extendable side
      brush and mop exist for.

      ROBOT CLEARANCES (oomwoo_one: 0.349 m body / 0.359 m over bumper,
      0.097 m tall including the LiDAR turret)
        - Under the dining table: legs 0.722 m apart minus 0.1 m leg = 0.622 m
          clear, lowest stretchers at z 0.187. It drives under and between.
        - Default spawn (x_pose -2.0, y_pose -0.5) is open floor.

      LIGHT WIREFRAMES: the green wireframe markers drawn on every light are
      an upstream gz-sim bug with no toggle in SDF or the GUI - see
      https://github.com/gazebosim/gz-sim/issues/1086 ("Light visuals are
      enabled by default"), still open. The only lever is FEWER LIGHTS, so
      this world uses a single ceiling fixture (plus the sun) - 2 markers.
    -->
    <scene>
      <shadows>false</shadows>
      <ambient>0.55 0.55 0.56 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
    </scene>
    <!--
      No <gui><camera> block on purpose. gz-sim 8 does not read it - it logs
      "gui camera can't be converted yet" and falls back to
      ~/.gz/sim/8/gui.config. Setting the view needs a gui plugin block with
      MinimalScene + camera_pose, but declaring any GUI plugin means the world
      must declare ALL of them or the toolbars disappear.
    -->
    <physics type='ode'>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.3999999999999999</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>1.0000000000000001e-05</cfm>
          <erp>0.20000000000000001</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <!-- Required for contact/bumper sensors to publish. A robot's model-level
         Contact plugin is a no-op; without this world-level system the contact
         topics exist but stay permanently silent. -->
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <include>
      <uri>model://ground plane</uri>
      <name>ground_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ==================== LIGHTING ====================
         The sun is back, at full strength and 10 m up, so the ground plane
         outside the room is lit again. It is a directional light, so its one
         direction lights the whole scene including everything beyond the
         walls - which is exactly what was missing.

         ONE ceiling fixture, at 2.40 m where a kitchen downlight actually
         sits. It was two, and before that four; the room read too bright, and
         each light also costs a green wireframe marker (see header). One
         still does the job the sun cannot - a directional light leaves every
         surface facing away from it on flat ambient, which is what made the
         walls read dark - while dropping the interior back down. Centred
         between the counters and the table so neither is hot-spotted. -->

    <light name='sun' type='directional'>
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <intensity>4</intensity>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.1 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <light name='ceiling_light' type='point'>
      <cast_shadows>false</cast_shadows>
      <pose>-0.2 0.1 2.4 0 -0 0</pose>
      <diffuse>1 0.97 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <intensity>0.6</intensity>
      <attenuation>
        <range>8</range>
        <constant>0.35</constant>
        <linear>0.12</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
    </light>

    <!-- ==================== SHELL ==================== -->
    <!-- Wall centres are 0.05 outside the interior faces (walls are 0.1
         thick). Corners overlap, so the box is closed. -->

    <model name='wall_west'>
      <static>true</static>
      <include>
        <uri>model://room_wall_25x4m</uri>
      </include>
      <pose>-2.5 0 1.25 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='wall_east'>
      <static>true</static>
      <include>
        <uri>model://room_wall_25x4m</uri>
      </include>
      <pose>2.5 0 1.25 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='wall_south'>
      <static>true</static>
      <include>
        <uri>model://room_wall_25x5m</uri>
      </include>
      <pose>0 -1.95 1.25 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='wall_north'>
      <static>true</static>
      <include>
        <uri>model://room_wall_25x5m</uri>
      </include>
      <pose>0 1.95 1.25 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Entry door on the WEST wall, north end: spans y 0.100..0.900, with the
         fridge flank starting at y 1.140. Visual only, no collision, like in
         living_room: it reads as a doorway, it is not an opening. Inset 5 mm
         proud of the wall face so it does not z-fight. -->
    <model name='door_08x2m'>
      <static>true</static>
      <include>
        <uri>model://door_08x2m</uri>
      </include>
      <pose>-2.495 0.5 1 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Auto-empty / mop-wash dock, backed against the WEST wall and centred on
         the default spawn line y = -0.5 - directly behind the robot, which
         spawns at (-2.0, -0.5) facing +x and reverses west into it.

         Dock occupies x -2.450..-2.110, y -0.730..-0.270, z 0..0.580.
         Bay interior  x -2.350..-2.110, y -0.700..-0.300, z 0..0.170,
         closed at the back by a 0.100 m spacer block for charging contacts.

         Backed fully in the robot is 67% inside and its LiDAR clears the mouth
         by 14 mm (the turret sits 0.0745 m forward of centre). The bay carries
         NO collision geometry, so the robot can sit in it freely.

         At the default x_pose the robot's tail is 69 mm into the mouth, i.e.
         just pulled out. Set x_pose:=-2.17 to have it spawn fully docked.

         It clears the door (y 0.100..0.900) and tucks under the poster above
         (z 1.000..2.000). -->
    <model name='vacuum_dock'>
      <static>true</static>
      <include>
        <uri>model://vacuum_dock</uri>
      </include>
      <pose>-2.45 -0.5 0 0 -0 1.5708</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Basic charging dock - the pad style, the simple alternative to the
         auto-empty dock above. The robot drives ONTO this one, so it needs
         approach room rather than a bay. Against the SOUTH wall facing north,
         occupying x -2.010..-1.790, y -1.900..-1.755, z 0..0.098.

         It sits under the south-west curtain, which starts at z 0.250, and
         has 0.705 m of open floor in front of it before the dining table at
         y -1.050 - ample for a 0.359 m robot to line up and drive in. -->
    <model name='charging_dock_basic'>
      <static>true</static>
      <include>
        <uri>model://charging_dock_basic</uri>
      </include>
      <pose>-1.9 -1.9 0 0 -0 3.1416</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Makerspet decoration, west wall, south of the door: spans y
         -1.029..-0.171 at eye level (z 1.000..2.000). -->
    <model name='makerspet_poster'>
      <static>true</static>
      <include>
        <uri>model://makerspet_poster</uri>
      </include>
      <pose>-2.435 -0.6 1.5 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Windows are curtain decals on the wall face, not openings. The two
         south ones are full height; the east one is the short variant, sitting
         ON the counter (bottom 0.900, top 2.300). -->
    <model name='window_curtains_south_west'>
      <static>true</static>
      <include>
        <uri>model://window_curtains</uri>
      </include>
      <pose>-1.4 -1.89 1.25 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='window_curtains_south_east'>
      <static>true</static>
      <include>
        <uri>model://window_curtains</uri>
      </include>
      <pose>0.85 -1.89 1.25 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Above the sink, on the east wall. -->
    <model name='window_curtains_east'>
      <static>true</static>
      <include>
        <uri>model://window_curtains_small</uri>
      </include>
      <pose>2.44 0.75 1.6 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- ============ NORTH WALL: fridge, counter, RANGE, counter ============ -->

    <!-- French-door fridge, authored. Replaces Fuel's Fridge, a 0.588 m
         single-door unit; this is 0.900 wide at typical US proportions, with
         handles and a brushed stainless finish. -->
    <model name='fridge_double_door'>
      <static>true</static>
      <include>
        <uri>model://fridge_double_door</uri>
      </include>
      <pose>-2 1.9 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Counter west of the range. Spans x -1.550..-0.406. -->
    <model name='kitchen_base_run_w'>
      <static>true</static>
      <include>
        <uri>model://kitchen_base_run_w</uri>
      </include>
      <pose>-0.978 1.9 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- The range, centred on the north wall. Scaled 0.8452 so its top lands
         at 0.9001 - level with the counter - and its depth at 0.6377, within
         3 mm of the counter's 0.635. Yawed -90 deg to face the room. -->
    <model name='Oven'>
      <static>true</static>
      <include>
        <uri>model://Oven</uri>
      </include>
      <pose>0 1.5811 0 0 -0 -1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Counter east of the range. Spans x 0.406..1.787, meeting the east
         run's front face exactly. -->
    <model name='kitchen_base_run_e'>
      <static>true</static>
      <include>
        <uri>model://kitchen_base_run_e</uri>
      </include>
      <pose>1.0965 1.9 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Hood over the range. Canopy underside at 1.600, so 0.700 above the
         cooktop - within the usual 0.600-0.750. -->
    <model name='range_hood'>
      <static>true</static>
      <include>
        <uri>model://range_hood</uri>
      </include>
      <pose>0 1.9 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Wall cabinets flanking the hood, aligned over the base runs. -->
    <model name='kitchen_wall_cab_w'>
      <static>true</static>
      <include>
        <uri>model://kitchen_wall_cab_w</uri>
      </include>
      <pose>-0.978 1.9 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='kitchen_wall_cab_e'>
      <static>true</static>
      <include>
        <uri>model://kitchen_wall_cab_e</uri>
      </include>
      <pose>1.0965 1.9 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- On the counter west of the range, pushed back against the wall: its
         local bounds run y -0.1737..0.1017, so y = 1.798 puts its back face on
         1.8997, a hair off the wall at 1.900. -->
    <model name='coffee_maker'>
      <static>true</static>
      <include>
        <uri>model://coffee_maker</uri>
      </include>
      <pose>-1 1.798 0.9 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- ============ EAST WALL: sink run, then pantry ============ -->

    <!-- Yawed -90 deg so the run grows west off the east wall. Spans
         y -1.25..1.90; the double sink lands at y 0.75, under the window. -->
    <model name='kitchen_base_run_east'>
      <static>true</static>
      <include>
        <uri>model://kitchen_base_run_east</uri>
      </include>
      <pose>2.45 0.325 0 0 -0 -1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Dishwasher, dropped into the 0.600 m appliance gap the east run
         leaves beside the sink. Spans y -0.320..0.280, i.e. immediately to
         the right of the sink opening (y 0.370..1.130) with 0.090 m of
         cabinet between them. The counter runs over it, the toe kick under. -->
    <model name='dishwasher'>
      <static>true</static>
      <include>
        <uri>model://dishwasher</uri>
      </include>
      <pose>2.45 -0.02 0 0 -0 -1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Corner wall cabinet, filling the NE corner left of the sink. It hangs
         on the NORTH wall facing SOUTH, not on the east wall facing west.
         Facing west it stared straight at the east end of kitchen_wall_cab_e
         across a 0.25 m gap, so its door could never have opened; turned this
         way it opens into the room, over the sink. Spans x 1.850..2.450,
         leaving 0.063 m to kitchen_wall_cab_e. -->
    <model name='kitchen_wall_cab_ec'>
      <static>true</static>
      <include>
        <uri>model://kitchen_wall_cab_ec</uri>
      </include>
      <pose>2.15 1.9 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='kitchen_wall_cab_es'>
      <static>true</static>
      <include>
        <uri>model://kitchen_wall_cab_es</uri>
      </include>
      <pose>2.45 -0.525 0 0 -0 -1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Pantry at the far (south) end of the east wall, flush to the south
         wall. Same toe kick as the runs, so the kick line stays continuous. -->
    <model name='kitchen_pantry'>
      <static>true</static>
      <include>
        <uri>model://kitchen_pantry</uri>
      </include>
      <pose>2.45 -1.6 0 0 -0 -1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- ================== DINING ================== -->
    <!-- Table centred in the free floor. Yawed +90 deg so its 2.35 m length
         runs east-west. Top at 0.74 m. -->

    <model name='DiningTable'>
      <static>true</static>
      <include>
        <uri>model://DiningTable</uri>
      </include>
      <pose>-0.33 -0.55 0 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Two chairs each side, seats facing the table. The west pair - the two
         unoccupied chairs facing each other - are pushed right in, seats under
         the top, as unused chairs are. They stop where their backrests reach
         the table edge, since a backrest stands 0.956 high and cannot go under
         a 0.740 top. The chair
         model's backrest is on its +y side, so yaw 0 faces south and yaw pi
         faces north. -->
    <model name='dining_chair_n_west'>
      <static>true</static>
      <include>
        <uri>model://DiningChair</uri>
      </include>
      <pose>-0.93 -0.2 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='dining_chair_n_east'>
      <static>true</static>
      <include>
        <uri>model://DiningChair</uri>
      </include>
      <pose>0.27 0.15 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='dining_chair_s_west'>
      <static>true</static>
      <include>
        <uri>model://DiningChair</uri>
      </include>
      <pose>-0.93 -0.9 0 0 -0 3.1416</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='dining_chair_s_east'>
      <static>true</static>
      <include>
        <uri>model://DiningChair</uri>
      </include>
      <pose>0.27 -1.25 0 0 -0 3.1416</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- ============== OCCUPANTS AND PROPS ============== -->

    <!-- Standing at the sink, facing east into it. The mesh faces -y, so yaw
         +90 deg turns it to +x. Body occupies x 1.389..1.752 (counter front is
         1.815) and y 0.473..1.017, squarely in front of the sink opening
         (y 0.370..1.130) and under the window. Forced static: upstream ships
         this model DYNAMIC with 80 kg of inertia, so it would topple. -->
    <model name='person_standing'>
      <static>true</static>
      <include>
        <uri>model://person_standing</uri>
      </include>
      <pose>1.5 0.75 0 0 -0 1.5708</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Seated on dining_chair_s_east, the chair nearest the pantry, facing
         north to the table. Scaled 1.1037 inside the model so her feet stay on
         the floor AND her buttocks meet the 0.447 m chair seat; her contact
         patch is offset (0.039, 0.005) in her own frame, hence the pose being
         (0.275, -1.288) rather than the chair centre (0.270, -1.250). -->
    <model name='PatientFSit'>
      <static>true</static>
      <include>
        <uri>model://PatientFSit</uri>
      </include>
      <pose>0.275 -1.288 0 0 -0 1.5708</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Plate of salad on the table, directly in front of her. Fuel lists this
         mesh as "ProSport_Harness_to_Booster_Seat", which is plainly wrong -
         the geometry and texture are a plate of salad. Vendored as salad_plate. -->
    <model name='salad_plate'>
      <static>true</static>
      <include>
        <uri>model://salad_plate</uri>
      </include>
      <pose>0.27 -0.85 0.74 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Small appliances along the west counter, all backed up to the wall and
         all well under the wall cabinets at 1.500. West to east:
         pressure cooker (top 1.191), coffee maker (1.255), toaster (1.085).
         The cooker and toaster are authored from primitives - see models/ -
         because the Fuel scans cost 25k and 48k triangles for objects a few
         hundred pixels across, and decimating a scan destroys its UVs. -->
    <model name='pressure_cooker'>
      <static>true</static>
      <include>
        <uri>model://pressure_cooker</uri>
      </include>
      <pose>-1.34 1.73 0.9 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='toaster_4_slice'>
      <static>true</static>
      <include>
        <uri>model://toaster_4_slice</uri>
      </include>
      <pose>-0.65 1.78 0.9 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Dish drainer on the east counter, right of the sink and directly over
         the dishwasher (y -0.318..0.278) - where a drainer actually goes. -->
    <model name='dish_drainer'>
      <static>true</static>
      <include>
        <uri>model://dish_drainer</uri>
      </include>
      <pose>2.14 -0.02 0.9 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

  </world>
</sdf>
