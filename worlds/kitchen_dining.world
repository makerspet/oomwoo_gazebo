<sdf version='1.10'>
  <world name='default'>
    <!--
      Kitchen + dining room for the OOMWOO robot vacuum.

      Composed from individually vendored models (models/), not one monolithic
      mesh, so every piece can be moved, swapped or reused by the bedroom /
      office / bathroom worlds later. Nothing is fetched at run time.

      ROOM
        Interior  x [-2.45, 2.45]  = 4.90 m
                  y [-1.90, 1.90]  = 3.80 m   -> 18.6 m^2
        Ceiling   2.50 m (room_wall_25x*m). NOT the 2.0 m of living_room's
                  room_wall_2x5m: a 2 m wall cannot fit a 1.08 m wall cabinet
                  hung above a counter, let alone a range hood above that.

      ROBOT CLEARANCES (oomwoo_one: 0.349 m body / 0.359 m over bumper,
      0.097 m tall including the LiDAR turret)
        - Under the dining table: legs 0.722 m apart minus 0.1 m leg = 0.622 m
          clear, and the lowest stretchers are at z 0.187 m. The robot drives
          under and between the legs. This is the "go under" test case.
        - Oven to east wall: 0.359 m. Exactly the bumper width, on purpose -
          a dead gap the robot must decide about rather than wedge into.
        - Default spawn (x_pose -2.0, y_pose -0.5) is open floor: 0.45 m to the
          west wall, 0.825 m to the table. No need to override it.

      KNOWN ISSUES, both in the upstream Fuel assets, both one-line fixes:
        1. KitchenCountertop's work surface is at 0.74 m, not the standard
           0.90 m - it is modelled on a CHART lab bench. It will read as short
           next to the 1.065 m Oven. To correct it, change its pose z from 0
           to 0.16. Left as authored so it can be judged as-is first.
        2. The Fridge's door face is its -y side (73 of its 89 vertices are on
           that face), so at yaw 0 the doors face south into the room. If they
           turn out to face the wall, add 3.1416 to both fridge yaw values.
    -->
    <scene>
      <shadows>false</shadows>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
    </scene>
    <!--
      No <gui><camera> block here on purpose. gz-sim 8 does not read it - it
      logs "gui camera can't be converted yet" and falls back to
      ~/.gz/sim/8/gui.config. (living_room.world, empty.world and
      turtlebot3_house.world all still carry that dead block.) Setting the
      view needs a gui plugin block with MinimalScene + camera_pose, but
      declaring any GUI plugin means the world must declare ALL of them or
      the toolbars disappear. Left out until we decide we want that.
    -->
    <physics type='ode'>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.3999999999999999</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>1.0000000000000001e-05</cfm>
          <erp>0.20000000000000001</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <!-- Required for contact/bumper sensors to publish. A robot's model-level
         Contact plugin is a no-op; without this world-level system the contact
         topics exist but stay permanently silent. -->
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <include>
      <uri>model://ground plane</uri>
      <name>ground_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <light name='sun' type='directional'>
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <intensity>4</intensity>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ==================== SHELL ==================== -->
    <!-- Wall centres are 0.05 outside the interior faces (walls are 0.1
         thick). Corners overlap, so the box is closed. -->

    <model name='wall_west'>
      <static>true</static>
      <include>
        <uri>model://room_wall_25x4m</uri>
      </include>
      <pose>-2.5 0 1.25 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='wall_east'>
      <static>true</static>
      <include>
        <uri>model://room_wall_25x4m</uri>
      </include>
      <pose>2.5 0 1.25 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='wall_south'>
      <static>true</static>
      <include>
        <uri>model://room_wall_25x5m</uri>
      </include>
      <pose>0 -1.95 1.25 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='wall_north'>
      <static>true</static>
      <include>
        <uri>model://room_wall_25x5m</uri>
      </include>
      <pose>0 1.95 1.25 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Windows are curtain decals on the wall face, not openings.
         The south wall carries two of them, 1.5676 m wide each, spanning
         x -2.184..-0.616 and x 0.416..1.984 - no overlap, both inside the
         wall. There is deliberately NO door in this room now; add one back
         on the west wall if the robot ever needs to leave. -->
    <model name='window_curtains_east'>
      <static>true</static>
      <include>
        <uri>model://window_curtains</uri>
      </include>
      <pose>2.44 0.3 1.25 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='window_curtains_south_west'>
      <static>true</static>
      <include>
        <uri>model://window_curtains</uri>
      </include>
      <pose>-1.4 -1.89 1.25 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='window_curtains_south_east'>
      <static>true</static>
      <include>
        <uri>model://window_curtains</uri>
      </include>
      <pose>1.2 -1.89 1.25 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- ============ NORTH WALL WORKING RUN ============ -->
    <!-- West to east: fridge pair, countertop, range. All backs on y = 1.90.
         Run is 4.43 m of the 4.90 m wall. -->

    <!-- Two single-door fridges shoulder to shoulder, reading as one
         french-door unit. Each is 0.588 wide, so the pair is 1.176. -->
    <model name='fridge_left'>
      <static>true</static>
      <include>
        <uri>model://Fridge</uri>
      </include>
      <pose>-2.15 1.627 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='fridge_right'>
      <static>true</static>
      <include>
        <uri>model://Fridge</uri>
      </include>
      <pose>-1.562 1.627 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Countertop with the sink and cooktop. Yawed -90 deg so its 2.29 m
         length runs along the wall and it FACES THE ROOM. (At +90 it faced
         the wall - the model's front is its local +x, not its back.) The y
         centre moved 1.524 -> 1.5358 to keep the back on y = 1.90, because
         the local x bounds are asymmetric: -0.3641 at the back, +0.3757 at
         the front. Flipping it also swapped the ends: the COOKTOP is now at
         the west end (x -1.19..-0.46) and the SINK at the east end
         (x 0.34..1.04), by the window. -->
    <model name='KitchenCountertop'>
      <static>true</static>
      <include>
        <uri>model://KitchenCountertop</uri>
      </include>
      <pose>-0.06 1.5358 0 0 -0 -1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Slide-in range, east end of the run, also turned to face the room.
         Its local x bounds are symmetric (+/-0.3773), so unlike the
         countertop the flip needs no y correction. -->
    <model name='Oven'>
      <static>true</static>
      <include>
        <uri>model://Oven</uri>
      </include>
      <pose>1.61 1.522 0 0 -0 -1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Authored, since Fuel has no range hood. Origin is on the floor;
         canopy underside lands at 1.70 m, 0.635 m above the range top. -->
    <model name='range_hood'>
      <static>true</static>
      <include>
        <uri>model://range_hood</uri>
      </include>
      <pose>1.61 1.65 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Two wall cabinets over the countertop. Bottom at 1.42 m, so they top
         out at 2.50 m exactly flush with the ceiling, and leave 0.68 m of
         clearance above the work surface. -->
    <model name='wall_cabinet_left'>
      <static>true</static>
      <include>
        <uri>model://WhiteCabinet</uri>
      </include>
      <pose>-0.51 1.675 1.42 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='wall_cabinet_right'>
      <static>true</static>
      <include>
        <uri>model://WhiteCabinet</uri>
      </include>
      <pose>0.39 1.675 1.42 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- On the work surface (0.742 m), on the clear stretch between the sink
         and the cooktop. Raise this z with the countertop if that gets fixed. -->
    <model name='coffee_maker'>
      <static>true</static>
      <include>
        <uri>model://coffee_maker</uri>
      </include>
      <pose>0 1.6 0.742 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- ================== DINING ================== -->
    <!-- Table centred in the free floor south of the run. Yawed +90 deg so
         its 2.35 m length runs east-west. Top at 0.74 m. -->

    <model name='DiningTable'>
      <static>true</static>
      <include>
        <uri>model://DiningTable</uri>
      </include>
      <pose>0 -0.55 0 0 -0 1.5707</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Two chairs each side, tucked in, seats facing the table. The chair
         model's backrest is on its +y side, so yaw 0 faces south and yaw pi
         faces north. -->
    <model name='dining_chair_n_west'>
      <static>true</static>
      <include>
        <uri>model://DiningChair</uri>
      </include>
      <pose>-0.6 0.15 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='dining_chair_n_east'>
      <static>true</static>
      <include>
        <uri>model://DiningChair</uri>
      </include>
      <pose>0.6 0.15 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='dining_chair_s_west'>
      <static>true</static>
      <include>
        <uri>model://DiningChair</uri>
      </include>
      <pose>-0.6 -1.25 0 0 -0 3.1416</pose>
      <self_collide>false</self_collide>
    </model>

    <model name='dining_chair_s_east'>
      <static>true</static>
      <include>
        <uri>model://DiningChair</uri>
      </include>
      <pose>0.6 -1.25 0 0 -0 3.1416</pose>
      <self_collide>false</self_collide>
    </model>

  </world>
</sdf>
