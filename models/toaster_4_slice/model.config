<?xml version="1.0" ?>
<model>
    <name>toaster_4_slice</name>
    <version>1.0</version>
    <sdf version="1.6">model.sdf</sdf>
    <author>
        <name>Ilia O.</name>
        <email>iliao@kaia.ai</email>
    </author>
    <description>Two-slot toaster, 0.124 x 0.230 x 0.185 m, authored from primitives with rounded edges (crossed boxes plus corner cylinders). Two parallel slots run front-to-back with cylinder-capped rounded ends, a capsule carriage lever and an ellipsoid browning dial. Replaces a 47,628-triangle Google Scanned Objects scan; decimating that scan destroys its UVs, so it was rebuilt instead.</description>
</model>
