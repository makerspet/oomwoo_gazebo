<?xml version="1.0" ?>
<model>
    <name>range_hood</name>
    <version>1.0</version>
    <sdf version='1.6'>model.sdf</sdf>
    <author>
        <name>Ilia O.</name>
        <email>iliao@kaia.ai</email>
    </author>
    <description>A wall-mounted stainless range hood built from boxes: a
    900x500mm canopy with its underside 1.70m above the floor, and a 300x250mm
    chimney running from the canopy up to a 2.5m ceiling. Fuel has no range
    hood, so this is authored. Sized to sit over the Oven model (top at 1.065m),
    giving 635mm of clearance above the cooktop - within the usual 600-750mm.
    Model origin is on the FLOOR at the canopy centre, so place it at z=0.
    The chimney assumes a 2.5m ceiling (room_wall_25x*m); shorten it for a
    different ceiling height.</description>
</model>
