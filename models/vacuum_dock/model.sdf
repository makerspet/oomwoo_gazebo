      <!-- IR beacon. It sits at the back of the bay on the centreline, at the
           height of the robot's rear receivers (floor clearance 0.0125 plus half
           the body cylinder, 0.03325). Recessed in the bay, its light escapes
           through the mouth in a wedge of about +-40 degrees, so the robot has
           to be parked roughly in front of the dock to see it at all. Purely
           cosmetic here: ir_beacon_sim computes what the receivers would see. -->
      <visual name="ir_beacon">
        <pose>0 -0.105 0.0458 0 0 0</pose>
        <geometry><box><size>0.024 0.008 0.012</size></box></geometry>
