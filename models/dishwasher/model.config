<?xml version="1.0" ?>
<model>
    <name>dishwasher</name>
    <version>1.0</version>
    <sdf version="1.6">model.sdf</sdf>
    <author>
        <name>Ilia O.</name>
        <email>iliao@kaia.ai</email>
    </author>
    <description>Integrated under-counter dishwasher, 0.596 wide x 0.580 deep, spanning z 0.089 to 0.860 so it sits between the toe kick and the counter underside. Brushed stainless door flush with the cabinet fronts, dark control panel along the top edge, horizontal stainless bar handle. Drops into the 0.600 m appliance gap that kitchen_base_run_east leaves beside the sink. Origin is the back (wall) face, centred on width, on the floor.</description>
</model>
