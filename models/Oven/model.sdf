<?xml version="1.0" encoding="UTF-8"?>
<!--
  Oven by Open Robotics (Gazebo Fuel, CC-BY 4.0), vendored for oomwoo_gazebo.

  Two changes from upstream:
   1. Uniformly scaled by %.4f. At 1:1 the range stood 1.0649 m tall and
      0.7545 m deep, so it sat proud of the 0.900 m counter and stuck out
      past its 0.635 m depth. One uniform factor fixes both at once:
      height -> 0.9001 (level with the counter), depth -> 0.6377 (2.7 mm
      proud, invisible), width -> 0.8126 (a 32" range). The collision box
      is scaled by the same factor.
   2. materials/textures/Oven_Albedo.png was edited: the control knobs were
      painted pure red (155,7,7). Those 18518 pixels were recoloured to a
      dark grey, keeping their original luminance so the knobs keep their
      shading. No other pixels were touched.
-->
<sdf version="1.6">
  <model name="Oven">
    <static>true</static>
    <link name="base_link">
      <visual name="visual_oven">
        <geometry>
          <mesh>
            <scale>0.8452 0.8452 0.8452</scale>
            <uri>meshes/oven.dae</uri>
            <submesh>
              <name>Oven</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/Oven_Albedo.png</albedo_map>
              <normal_map>materials/textures/Oven_Normal.png</normal_map>
              <roughness_map>materials/textures/Oven_Roughness.png</roughness_map>
              <metalness_map>materials/textures/Oven_Metalness.png</metalness_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="visual_glass">
        <geometry>
          <mesh>
            <scale>0.8452 0.8452 0.8452</scale>
            <uri>meshes/oven.dae</uri>
            <submesh>
              <name>Glass</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/Glass.png</albedo_map>
              <roughness>0.1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="Box001">
        <pose>-0.000257 -1.41058e-06 0.437055 0.0 0.0 0.0</pose>
        <geometry>
          <box>
            <size>0.58448 0.81688 0.87411</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
