<?xml version="1.0"?>

<model>
  <name>Sofa</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Wan Yi Seow</name>
    <email>wanyi@openrobotics.org</email>
  </author>

  <description>
    A grey comfortable sofa
   Material and texture names were also made unique per model (upstream used the generic name "material_0" with a texture called "texture.png", which several models shared - Gazebo caches those globally by name, so they overwrote each other and models rendered with the wrong texture).</description>

</model>

