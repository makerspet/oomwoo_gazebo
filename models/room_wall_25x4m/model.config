<?xml version="1.0" ?>
<model>
    <name>room_wall_25x4m</name>
    <version>1.0</version>
    <sdf version='1.4'>model.sdf</sdf>
    <author>
        <name>Ilia O.</name>
        <email>iliao@kaia.ai</email>
    </author>
    <description>A 2.5m tall by 4.0m drywall-textured room wall. Taller
    variant of room_wall_2x5m: a 2m wall cannot fit wall cabinets (1.08m) hung
    above a counter, nor a range hood, so kitchen-style rooms use 2.5m. The wall texture is living_room's wall_texture_1404x562.jpg, mirror-extended and cropped to this wall's aspect so the texel density stays 280.8 px/m in both axes - stretching the original to a 2.5m wall would have distorted it by 25-56%.</description>
</model>
