<?xml version="1.0"?>
<model>
  <name>MiniSofa</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Wan Yi</name>
    <email>wanyi@osrfoundation.org</email>
  </author>

  <description>
	a terrible sofa
   Modified for oomwoo_gazebo: scaled 1.5729 in Z only, lifting the seat cushion from 0.270 m to 0.425 m so a correctly-sized seated figure makes contact. Footprint and geometry are otherwise unchanged. Material and texture names were also made unique per model (upstream used the generic name "material_0" with a texture called "texture.png", which several models shared - Gazebo caches those globally by name, so they overwrote each other and models rendered with the wrong texture).</description>
</model>
